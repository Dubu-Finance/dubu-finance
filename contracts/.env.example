# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Two ways to sign. Prefer the keystore.
#
#   keystore (recommended):
#     cast wallet import dubu-deployer --interactive
#     then pass --account dubu-deployer to forge, and leave PRIVATE_KEY empty
#
#   raw key (testnet only):
#     PRIVATE_KEY=0x...
#
PRIVATE_KEY=
DEPLOYER=0x5AD176eBb13CAbE62Ee7c07F52a67b4A48CbEf83

GIWA_SEPOLIA_RPC=https://sepolia-rpc.giwa.io
GIWA_SEPOLIA_FLASHBLOCKS_RPC=https://sepolia-rpc-flashblocks.giwa.io
GIWA_SEPOLIA_EXPLORER_API=https://sepolia-explorer.giwa.io/api

# Live on GIWA Sepolia — see context/archi_v2.md section 1
PYTH=0x2880aB155794e7179c9eE2e38200202908C17B43
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11
WETH9=0x4200000000000000000000000000000000000006
ONCHAIN_VERIFIER=0xd5077b67dcb56caC8b270C7788FC3E6ee03F17B9
UPBIT_KOREA_ATTESTER=0xd99b42e778498aa3c9c1f6a012359130252780511687a35982e8e52735453034

# Roles. All four default to DEPLOYER on testnet, but the whole point of the split is that
# they diverge in production: updater is hot and must be able to move zero funds, guardian
# lives on separate hardware, owner ends up behind a timelock.
OWNER=
MANAGER=
UPDATER=
GUARDIAN=
